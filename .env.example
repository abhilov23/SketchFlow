# ---------------------------------------------------------------- Prisma
# Required. Postgres connection string, e.g. Neon / Supabase / local Postgres.
DATABASE_URL=

# ---------------------------------------------------------------- Auth
# Required. MUST be at least 32 characters — the servers refuse to start otherwise.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional. Access token lifetime (jsonwebtoken format). Default: 7d
# JWT_EXPIRES_IN=7d

# Optional. bcrypt cost factor. Higher is slower and stronger. Default: 12
# BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- Ports
# Optional. The backends read these; the frontend is configured separately.
# HTTP_BACKEND_PORT=3005
# WS_BACKEND_PORT=8089

# Optional. Public origin of the HTTP API. Required in production so CORS is not
# left open to localhost only.
# PUBLIC_API_ORIGIN=https://api.example.com

# ---------------------------------------------------------------- Frontend
# Optional. Defaults shown. Set these when the API is not on localhost.
# NEXT_PUBLIC_HTTP_BACKEND=http://localhost:3005
# NEXT_PUBLIC_WS_URL=ws://localhost:8089